--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 29e55426216fb29eab3098b34141b4d7, type: 3}
  m_Name: 01_Introduction
  m_EditorClassIdentifier: 
  dialogs:
  - name: Kamu
    dialog: "\u201CHalo teman-teman\u201D   "
    boySprite: {fileID: 2077771902, guid: d24185bbdccd0c0e59f864cfdd055495, type: 3}
    girlSprite: {fileID: -1152140505, guid: 3e298504794a7e6659d767fa6a6531f3, type: 3}
    fireOnNewLine: 0
  - name: Kamu
    dialog: "\u201CHari ini aku punya misi penting untuk kita!\u201D "
    boySprite: {fileID: -172031771, guid: 10fab932faa386eefb466756b315a848, type: 3}
    girlSprite: {fileID: 2099572467, guid: c849aac727f35c4eb8e85e7ae045dbb0, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CMisi kita adalah... membasmi kotoran dan sampah!\u201D "
    boySprite: {fileID: -172031771, guid: 10fab932faa386eefb466756b315a848, type: 3}
    girlSprite: {fileID: 2099572467, guid: c849aac727f35c4eb8e85e7ae045dbb0, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CPernah dengar pepatah \u2018bersih pangkal sehat\u2019?\u201D "
    boySprite: {fileID: -172031771, guid: 10fab932faa386eefb466756b315a848, type: 3}
    girlSprite: {fileID: 2099572467, guid: c849aac727f35c4eb8e85e7ae045dbb0, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CKalau ingin hidup sehat dan nyaman, kita harus menjaga lingkungan
      tetap bersih. Yuk, mulai dari rumah kita sendiri!\u201D "
    boySprite: {fileID: -172031771, guid: 10fab932faa386eefb466756b315a848, type: 3}
    girlSprite: {fileID: 2099572467, guid: c849aac727f35c4eb8e85e7ae045dbb0, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CSebelum mulai, yuk kita lihat alat kebersihan apa saja yang tersedia!\u201D  "
    boySprite: {fileID: 1947484184, guid: 12a68a71a0d2a7de5a1197fe284b3879, type: 3}
    girlSprite: {fileID: -1960993880, guid: c05079a73b5f585d0a0200302faa5d5d, type: 3}
    fireOnNewLine: 1
