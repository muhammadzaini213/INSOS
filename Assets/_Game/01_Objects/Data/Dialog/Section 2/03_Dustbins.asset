--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 29e55426216fb29eab3098b34141b4d7, type: 3}
  m_Name: 03_Dustbins
  m_EditorClassIdentifier: 
  dialogs:
  - name: Kamu
    dialog: "\u201CSekarang, saatnya memilah sampah!\u201D "
    boySprite: {fileID: -172031771, guid: 10fab932faa386eefb466756b315a848, type: 3}
    girlSprite: {fileID: 2099572467, guid: c849aac727f35c4eb8e85e7ae045dbb0, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CPisahkan sampah sesuai dengan jenisnya agar lebih mudah dikelola
      dan didaur ulang.\u201D "
    boySprite: {fileID: -172031771, guid: 10fab932faa386eefb466756b315a848, type: 3}
    girlSprite: {fileID: 2099572467, guid: c849aac727f35c4eb8e85e7ae045dbb0, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CMasukkan sampah organik ke tempat sampah hijau, seperti sisa buah,
      sayuran, tulang, dan sisa makanan.\u201D "
    boySprite: {fileID: -172031771, guid: 10fab932faa386eefb466756b315a848, type: 3}
    girlSprite: {fileID: 2099572467, guid: c849aac727f35c4eb8e85e7ae045dbb0, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CMasukkan sampah anorganik ke tempat sampah kuning, seperti botol,
      kaleng, plastik, dan kemasan.\u201D "
    boySprite: {fileID: -172031771, guid: 10fab932faa386eefb466756b315a848, type: 3}
    girlSprite: {fileID: 2099572467, guid: c849aac727f35c4eb8e85e7ae045dbb0, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CSedangkan sampah B3, seperti pecahan kaca, cermin, dan botol kaca
      yang pecah, masukkan ke tempat sampah merah.\u201D  "
    boySprite: {fileID: -172031771, guid: 10fab932faa386eefb466756b315a848, type: 3}
    girlSprite: {fileID: 2099572467, guid: c849aac727f35c4eb8e85e7ae045dbb0, type: 3}
    fireOnNewLine: 1
