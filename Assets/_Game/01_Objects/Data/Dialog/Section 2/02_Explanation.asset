  dialogs:
  - name: Kamu
    dialog: "\u201CIni dia alat-alat kebersihan yang bisa kita gunakan!\u201D "
    boySprite: {fileID: -172031771, guid: 10fab932faa386eefb466756b315a848, type: 3}
    girlSprite: {fileID: 2099572467, guid: c849aac727f35c4eb8e85e7ae045dbb0, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CAda alat pembersih, tempat sampah, kemoceng, sapu, pel, dan sapu
      lidi.\u201D "
    boySprite: {fileID: -172031771, guid: 10fab932faa386eefb466756b315a848, type: 3}
    girlSprite: {fileID: 2099572467, guid: c849aac727f35c4eb8e85e7ae045dbb0, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CSetiap alat memiliki kegunaan yang berbeda. Yuk, kita gunakan
      alat yang tepat untuk membersihkan lingkungan rumah kita!\u201D "
    boySprite: {fileID: -172031771, guid: 10fab932faa386eefb466756b315a848, type: 3}
    girlSprite: {fileID: 2099572467, guid: c849aac727f35c4eb8e85e7ae045dbb0, type: 3}
    fireOnNewLine: 1
