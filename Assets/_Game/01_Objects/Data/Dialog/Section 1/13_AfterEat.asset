  dialogs:
  - name: Kamu
    dialog: "\u201CEmmmm... roti lapisnya enak sekali!\u201D "
    boySprite: {fileID: -1009646442, guid: d6126f8a825dff8b2b2f99ab27af33a3, type: 3}
    girlSprite: {fileID: 982518046, guid: 9ba3011b3a0ec17f19cd684362503089, type: 3}
    fireOnNewLine: 0
  - name: Kamu
    dialog: "\u201CPerutku sudah kenyang. Sekarang, yuk kita bersiap untuk pergi
      ke sekolah!\u201D "
    boySprite: {fileID: -1009646442, guid: d6126f8a825dff8b2b2f99ab27af33a3, type: 3}
    girlSprite: {fileID: 982518046, guid: 9ba3011b3a0ec17f19cd684362503089, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201COiya, sebelum berangkat kita harus cek kembali isi tas\u201D "
    boySprite: {fileID: -1402580135, guid: d8a283af0513dbd45a66c6794165d001, type: 3}
    girlSprite: {fileID: -1639639005, guid: 0c3b6226c0d6a2b4f9cecdfb3281232c, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CAgar tidak ada yang tertinggal\u201D "
    boySprite: {fileID: -1402580135, guid: d8a283af0513dbd45a66c6794165d001, type: 3}
    girlSprite: {fileID: -1639639005, guid: 0c3b6226c0d6a2b4f9cecdfb3281232c, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CAyok ambil tas sekolah di kamar\u201D "
    boySprite: {fileID: -1009646442, guid: d6126f8a825dff8b2b2f99ab27af33a3, type: 3}
    girlSprite: {fileID: 982518046, guid: 9ba3011b3a0ec17f19cd684362503089, type: 3}
    fireOnNewLine: 1
