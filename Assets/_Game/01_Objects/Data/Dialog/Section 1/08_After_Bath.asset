  dialogs:
  - name: Kamu
    dialog: "\u201CWaaah, sekarang aku merasa jauh lebih segar setelah mandi!\u201D "
    boySprite: {fileID: -1009646442, guid: d6126f8a825dff8b2b2f99ab27af33a3, type: 3}
    girlSprite: {fileID: 982518046, guid: 9ba3011b3a0ec17f19cd684362503089, type: 3}
    fireOnNewLine: 0
  - name: Kamu
    dialog: "\u201CPerutku sudah berbunyi!\u201D "
    boySprite: {fileID: 1724654158, guid: ed6c5e833e05a51c6b80748b84264b88, type: 3}
    girlSprite: {fileID: -1800043789, guid: cac329636f769723a94f2ce68cef53f9, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CYuk, kita buat makanan yang mudah dan lezat untuk sarapan!\u201D"
    boySprite: {fileID: 1724654158, guid: ed6c5e833e05a51c6b80748b84264b88, type: 3}
    girlSprite: {fileID: -1800043789, guid: cac329636f769723a94f2ce68cef53f9, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CHmm... bagaimana kalau roti lapis? Kedengarannya lezat.\u201D "
    boySprite: {fileID: -1402580135, guid: d8a283af0513dbd45a66c6794165d001, type: 3}
    girlSprite: {fileID: -1639639005, guid: 0c3b6226c0d6a2b4f9cecdfb3281232c, type: 3}
    fireOnNewLine: 1
  - name: Kamu
    dialog: "\u201CKalau begitu mari kita pergi ke dapur\u201D "
    boySprite: {fileID: -1009646442, guid: d6126f8a825dff8b2b2f99ab27af33a3, type: 3}
    girlSprite: {fileID: 982518046, guid: 9ba3011b3a0ec17f19cd684362503089, type: 3}
    fireOnNewLine: 1
